+#ifdef __PROSPERO__
+#include <zip.h>
+#include <sys/stat.h>
+// PS5: the extractor's recipes can ship as one assets.zip beside eboot.bin (thousands of
+// small files are slow to copy to a console). Unpacked once into <exportdir>/assets, stamped
+// with the zip's size, time and ROM version; returns that folder, or "" when there is no zip.
+// Only the top-level files and <versionDir>/ are unpacked: the zip holds every ROM version
+// (~20k files) and the console writes ~2k small files a minute.
+static std::string Ps5UnpackAssetsZip(const std::string& installPath, const std::string& exportdir,
+                                      const std::string& versionDir, std::atomic<size_t>* done,
+                                      std::atomic<size_t>* total) {
+    const std::string zipPath = installPath + "/assets.zip";
+    struct stat st;
+    if (stat(zipPath.c_str(), &st) != 0) {
+        return "";
+    }
+    const std::string outDir = exportdir + "/assets";
+    const std::string stampPath = outDir + "/.zipstamp";
+    char stamp[128];
+    snprintf(stamp, sizeof(stamp), "%lld %lld %s", (long long)st.st_size, (long long)st.st_mtime,
+             versionDir.c_str());
+    {
+        std::ifstream in(stampPath);
+        std::string have;
+        std::getline(in, have);
+        if (have == stamp) {
+            return outDir;
+        }
+    }
+    int err = 0;
+    zip_t* zip = zip_open(zipPath.c_str(), ZIP_RDONLY, &err);
+    if (zip == nullptr) {
+        fprintf(stderr, "extractor: cannot open %s (%d)\n", zipPath.c_str(), err);
+        return "";
+    }
+    std::error_code ec;
+    std::filesystem::remove_all(outDir, ec);
+    std::filesystem::create_directories(outDir, ec);
+    const zip_int64_t n = zip_get_num_entries(zip, 0);
+    // Pick this version's entries, make their folders, then write files on several threads:
+    // the cost is per-file create latency on /data, not bandwidth.
+    std::vector<std::pair<zip_int64_t, std::string>> jobs;
+    for (zip_int64_t i = 0; i < n; i++) {
+        const char* name = zip_get_name(zip, i, 0);
+        if (name == nullptr || strstr(name, "..") != nullptr) {
+            continue;
+        }
+        std::string rel = name;
+        if (rel.rfind("assets/", 0) == 0) {
+            rel = rel.substr(7); // the zip may hold assets/ at its top
+        }
+        if (rel.empty()) {
+            continue;
+        }
+        const size_t slash = rel.find('/');
+        if (slash != std::string::npos && rel.compare(0, slash, versionDir) != 0) {
+            continue; // another ROM version's recipes
+        }
+        const std::filesystem::path dst = std::filesystem::path(outDir) / rel;
+        if (rel.back() == '/') {
+            std::filesystem::create_directories(dst, ec);
+            continue;
+        }
+        std::filesystem::create_directories(dst.parent_path(), ec);
+        jobs.emplace_back(i, dst.string());
+    }
+    zip_close(zip);
+    *total = jobs.size();
+    *done = 0;
+    std::atomic<size_t> next{ 0 }, files{ 0 };
+    auto worker = [&]() {
+        int e = 0;
+        zip_t* z = zip_open(zipPath.c_str(), ZIP_RDONLY, &e);
+        if (z == nullptr) return;
+        std::vector<char> buf(1 << 16);
+        for (size_t j; (j = next++) < jobs.size();) {
+            zip_file_t* zf = zip_fopen_index(z, jobs[j].first, 0);
+            FILE* out = fopen(jobs[j].second.c_str(), "wb");
+            if (zf != nullptr && out != nullptr) {
+                zip_int64_t got;
+                while ((got = zip_fread(zf, buf.data(), buf.size())) > 0) {
+                    fwrite(buf.data(), 1, (size_t)got, out);
+                }
+                *done = ++files;
+            }
+            if (out != nullptr) fclose(out);
+            if (zf != nullptr) zip_fclose(zf);
+        }
+        zip_close(z);
+    };
+    std::vector<std::thread> pool;
+    for (int t = 0; t < 6; t++) pool.emplace_back(worker);
+    for (auto& t : pool) t.join();
+    if (files != jobs.size()) {
+        fprintf(stderr, "extractor: unpacked only %zu of %zu files\n", (size_t)files, jobs.size());
+        return outDir; // no stamp: retried next launch
+    }
+    std::ofstream(stampPath) << stamp << "\n";
+    fprintf(stderr, "extractor: unpacked %lld files from %s into %s\n", (long long)files.load(), zipPath.c_str(), outDir.c_str());
+    return outDir;
+}
+#endif
+
+#ifdef __PROSPERO__
+#include "../../../torch/lib/TinySHA1.hpp"
+
+static std::string Ps5Sha1Hex(const std::vector<uint8_t>& data) {
+    sha1::SHA1 s;
+    s.processBytes(data.data(), data.size());
+    uint32_t d[5];
+    s.getDigest(d);
+    char buf[41];
+    snprintf(buf, sizeof(buf), "%08x%08x%08x%08x%08x", d[0], d[1], d[2], d[3], d[4]);
+    return buf;
+}
+
+static std::string Ps5SohVersion() {
+    char v[18];
+    snprintf(v, sizeof(v), "%d.%d.%d", gBuildVersionMajor, gBuildVersionMinor, gBuildVersionPatch);
+    return v;
+}
+
+// The port's release (param.json's contentVersion) and build (build_id.txt), for the record
+static std::string Ps5PortVersion(const std::string& installPath) {
+    std::string version = "unknown", build;
+    std::ifstream param(installPath + "/sce_sys/param.json");
+    std::string text((std::istreambuf_iterator<char>(param)), std::istreambuf_iterator<char>());
+    size_t key = text.find("\"contentVersion\"");
+    if (key != std::string::npos) {
+        size_t colon = text.find(':', key);
+        size_t q1 = colon == std::string::npos ? colon : text.find('"', colon);
+        size_t q2 = q1 == std::string::npos ? q1 : text.find('"', q1 + 1);
+        if (q2 != std::string::npos) {
+            version = text.substr(q1 + 1, q2 - q1 - 1);
+        }
+    }
+    std::ifstream(installPath + "/build_id.txt") >> build;
+    return build.empty() ? version : version + " (" + build + ")";
+}
+
+bool Ps5O2RStampMatches(const std::string& archivePath, std::string* why) {
+    std::ifstream in(archivePath + ".stamp");
+    if (!in) {
+        *why = "no provenance stamp (made by another tool or port, or by 01.000.000)";
+        return false;
+    }
+    std::string line, madeBy, soh, size;
+    while (std::getline(in, line)) {
+        size_t sp = line.find(' ');
+        if (sp == std::string::npos) {
+            continue;
+        }
+        std::string key = line.substr(0, sp), value = line.substr(sp + 1);
+        if (key == "made-by") {
+            madeBy = value;
+        } else if (key == "soh") {
+            soh = value;
+        } else if (key == "o2r-size") {
+            size = value;
+        }
+    }
+    std::error_code ec;
+    const uintmax_t actual = std::filesystem::file_size(archivePath, ec);
+    if (madeBy != "PS5_Shipwright") {
+        *why = "the stamp was not written by this port";
+    } else if (soh != Ps5SohVersion()) {
+        *why = "made for SoH " + soh + ", this is SoH " + Ps5SohVersion();
+    } else if (ec || size != std::to_string(actual)) {
+        *why = "the archive was replaced after it was made (size " + std::to_string(actual) + ", stamp says " +
+               size + ")";
+    } else {
+        return true;
+    }
+    return false;
+}
+
+void Ps5WriteO2RStamp(const std::string& archivePath, const std::string& installPath, const std::string& romPath,
+                      const std::string& romSha1) {
+    std::error_code ec;
+    const uintmax_t size = std::filesystem::file_size(archivePath, ec);
+    if (ec) {
+        return;
+    }
+    {
+        std::ofstream out(archivePath + ".stamp", std::ios::trunc);
+        out << "made-by PS5_Shipwright\n"
+            << "port " << Ps5PortVersion(installPath) << "\n"
+            << "soh " << Ps5SohVersion() << "\n"
+            << "rom " << std::filesystem::path(romPath).filename().string() << "\n"
+            << "rom-sha1 " << romSha1 << "\n"
+            << "o2r-size " << size << "\n";
+    }
+    SPDLOG_INFO("PS5: wrote {}.stamp (SoH {}, ROM SHA-1 {})", archivePath, Ps5SohVersion(), romSha1);
+}
+#endif
