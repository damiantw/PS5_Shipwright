diff --git a/CMakeLists.txt b/CMakeLists.txt
index 7951c1041..29312d8ba 100644
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -362,6 +362,10 @@ add_dependencies(ExtractAssets GenerateSohOtr)
 # The asset tools only need torch, so a tools-only configure can skip libultraship and soh
 # entirely -- that is all CI needs to produce soh.o2r.
 option(SOH_TOOLS_ONLY "Configure only the asset tools, skipping libultraship and soh" OFF)
+# PlayStation 5: soh.o2r comes from a host build of the packer (ps5/tools/assets.sh)
+if(PS5)
+    set_target_properties(GenerateSohOtr PROPERTIES EXCLUDE_FROM_ALL ON)
+endif()
 if(SOH_TOOLS_ONLY)
     file(MAKE_DIRECTORY ${CMAKE_BINARY_DIR}/soh)
     return()
diff --git a/soh/CMakeLists.txt b/soh/CMakeLists.txt
index f356d2148..a6994829e 100644
--- a/soh/CMakeLists.txt
+++ b/soh/CMakeLists.txt
@@ -398,7 +398,7 @@ elseif ("${CMAKE_CXX_COMPILER_ID}" MATCHES "GNU|Clang|AppleClang")
         "F3DEX_GBI_2;"
         "_CONSOLE;"
         "_CRT_SECURE_NO_WARNINGS;"
-        "ENABLE_OPENGL;"
+        "$<$<NOT:$<BOOL:${PS5}>>:ENABLE_OPENGL>;"
         "UNICODE;"
         "_UNICODE;"
         SPDLOG_ACTIVE_LEVEL=${SPDLOG_MIN_CUTOFF}
@@ -674,6 +674,16 @@ elseif(CMAKE_SYSTEM_NAME STREQUAL "NintendoSwitch")
         -lglad
         Threads::Threads
     )
+elseif(PS5)
+    # PlayStation 5: SDL2 with the console's drivers, audio codecs from source
+    # (ps5/cmake/ps5-game.cmake); no SDL2_net, no OpenGL
+    set(ADDITIONAL_LIBRARY_DEPENDENCIES
+        "libultraship;"
+        "torch;"
+        SDL2::SDL2
+        ogg vorbis vorbisenc vorbisfile opus opusfile
+        SDL2_net::SDL2_net-static
+    )
 elseif(CMAKE_SYSTEM_NAME STREQUAL "CafeOS")
     find_package(SDL2 REQUIRED)
     set(ADDITIONAL_LIBRARY_DEPENDENCIES
