+        CVarSetInteger(CVAR_SETTING("PS5.MenuDefaults"), 2);
+        CVarSave();
+    }
+    {
+        // more room around every item: a pad moves by item, and a TV is read from afar
+        ImGuiStyle& style = ImGui::GetStyle();
+        style.FramePadding = ImVec2(style.FramePadding.x * 1.5f, style.FramePadding.y * 1.6f);
+        style.ItemSpacing = ImVec2(style.ItemSpacing.x * 1.3f, style.ItemSpacing.y * 1.6f);
+        style.ItemInnerSpacing = ImVec2(style.ItemInnerSpacing.x * 1.3f, style.ItemInnerSpacing.y * 1.3f);
+        style.GrabMinSize *= 1.5f;
+    }
+#else
     previousImGuiScale = defaultImGuiScale;
+#endif
     ScaleImGui();
 }
 
