+    }
+    CVarSetInteger(CVAR_ENHANCEMENT("WidescreenActorCulling"), 1);
+    CVarSetInteger(CVAR_ENHANCEMENT("ExtendedCullingExcludeGlitchActors"), 1);
+    CVarSetInteger(CVAR_SETTING("PS5.MenuDefaults"), 5);
+    CVarSave();
+    SPDLOG_INFO("PS5 defaults v5: widescreen actor culling");
+}
