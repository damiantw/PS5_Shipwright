+// quarter-screen in from the edges. The glitch-relevant actors keep their original
+// culling (Cull Glitch Useful Actors). Applied once; both stay editable in the menu.
+static void Ps5ApplyWidescreenDefaults() {
+    if (CVarGetInteger(CVAR_SETTING("PS5.MenuDefaults"), 0) >= 5) {
