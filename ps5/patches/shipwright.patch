+#include "ship/controller/controldevice/controller/mapping/sdl/SDLButtonToButtonMapping.h"
+// PlayStation 5, menu defaults version 4: the right stick is the camera (SoH's Free
+// Look, and aiming in first person) and the C buttons move to the D-pad, which the
+// game does not otherwise use. Applied once, at the first frame (the control deck and
+// its saved mappings are loaded by then); the mappings stay editable in the menu.
+static void Ps5ApplyCameraDefaults() {
+    if (CVarGetInteger(CVAR_SETTING("PS5.MenuDefaults"), 0) >= 4) {
+        return;
+    }
+    auto controller = Ship::Context::GetRawInstance()->GetControlDeck()->GetControllerByPort(0);
+    if (!controller->HasConfig()) {
+        controller->AddDefaultMappings(Ship::PhysicalDeviceType::Keyboard);
+        controller->AddDefaultMappings(Ship::PhysicalDeviceType::SDLGamepad);
+    }
+    const struct {
+        CONTROLLERBUTTONS_T c, d;
+        SDL_GameControllerButton pad;
+    } dirs[] = {
+        { BTN_CUP, BTN_DUP, SDL_CONTROLLER_BUTTON_DPAD_UP },
+        { BTN_CDOWN, BTN_DDOWN, SDL_CONTROLLER_BUTTON_DPAD_DOWN },
+        { BTN_CLEFT, BTN_DLEFT, SDL_CONTROLLER_BUTTON_DPAD_LEFT },
+        { BTN_CRIGHT, BTN_DRIGHT, SDL_CONTROLLER_BUTTON_DPAD_RIGHT },
+    };
+    for (const auto& dir : dirs) {
+        auto cButton = controller->GetButton(dir.c);
+        std::vector<std::string> stale;
+        for (const auto& [id, mapping] : cButton->GetAllButtonMappings()) {
+            // the right stick's axes (SDL 2 = right X, 3 = right Y); keyboard and others stay
+            if (id.find("-SDLA2-AD") != std::string::npos || id.find("-SDLA3-AD") != std::string::npos) {
+                stale.push_back(id);
+            }
+        }
+        for (const auto& id : stale) {
+            cButton->ClearButtonMapping(id);
+        }
+        auto dpadMapping = std::make_shared<Ship::SDLButtonToButtonMapping>(0, dir.c, dir.pad);
+        cButton->AddButtonMapping(dpadMapping);
+        dpadMapping->SaveToConfig();
+        cButton->SaveButtonMappingIdsToConfig();
+        // the D-pad no longer also presses the N64 D-pad (no double input)
+        auto dButton = controller->GetButton(dir.d);
+        const std::string dId = Ship::SDLButtonToButtonMapping(0, dir.d, dir.pad).GetButtonMappingId();
+        if (dButton->GetAllButtonMappings().count(dId)) {
+            dButton->ClearButtonMapping(dId);
+        }
+    }
+    auto stick = controller->GetRightStick();
+    stick->ClearAllMappingsForDeviceType(Ship::PhysicalDeviceType::SDLGamepad);
+    stick->AddDefaultMappings(Ship::PhysicalDeviceType::SDLGamepad);
+    CVarSetInteger(CVAR_SETTING("FreeLook.Enabled"), 1);
+    CVarSetInteger(CVAR_SETTING("Controls.RightStickAim"), 1);
+    // a little quicker than the 100 % default: a full tilt turns the camera around in
+    // about a second at 60 fps
+    if (CVarGetFloat(CVAR_SETTING("FreeLook.CameraSensitivity.X"), 1.0f) == 1.0f) {
+        CVarSetFloat(CVAR_SETTING("FreeLook.CameraSensitivity.X"), 1.5f);
+    }
+    if (CVarGetFloat(CVAR_SETTING("FreeLook.CameraSensitivity.Y"), 1.0f) == 1.0f) {
+        CVarSetFloat(CVAR_SETTING("FreeLook.CameraSensitivity.Y"), 1.2f);
+    }
+    CVarSetInteger(CVAR_SETTING("PS5.MenuDefaults"), 4);
+    CVarSave();
+    ShipInit::Init(CVAR_SETTING("FreeLook.Enabled"));
+    SPDLOG_INFO("PS5 defaults v4: right stick = camera (Free Look), C buttons on the D-pad");
+}
