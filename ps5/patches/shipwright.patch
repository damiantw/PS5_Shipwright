 union Data {
     Data() {
     }
+#ifdef __PROSPERO__
+    // PlayStation 5 (from PS5_Ghostship): plain data, so a vector of these can grow under the SDK's libc++
+    Data(const Data& other) {
+        memcpy(static_cast<void*>(this), &other, sizeof(Data));
+    }
+    Data& operator=(const Data& other) {
+        memcpy(static_cast<void*>(this), &other, sizeof(Data));
+        return *this;
+    }
+#endif
 
