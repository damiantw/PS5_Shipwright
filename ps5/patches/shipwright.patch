+    std::string buildId;
+    std::getline(std::ifstream(std::filesystem::absolute(Ship::Context::GetAppBundlePath()).string() + "/build_id.txt"),
+                 buildId); // PS5_Shipwright commit + eboot sha256 (link-title.sh)
+    const std::string salt = Ps5ShaderWarmupSalt() + " " + (const char*)gGitCommitHash + " " + buildId;
+    mix(salt.data(), salt.size());
+    char stamp[32];
+    snprintf(stamp, sizeof(stamp), "%016llx", (unsigned long long)h);
+    const std::string stampPath = std::string(ps5_data_dir()) + "/cache/shader_warmup.stamp";
+    {
+        std::ifstream in(stampPath);
+        std::string have;
+        std::getline(in, have);
+        if (have == stamp) return;
+    }
+
+    std::atomic<size_t> done = 0;
+    std::atomic<bool> finished = false;
+    std::thread worker([&]() {
+        Ps5ShaderWarmup(keys, &done);
+        finished = true;
+    });
+    auto wnd = std::dynamic_pointer_cast<Fast::Fast3dWindow>(OTRGlobals::Instance->context->GetWindow());
+    auto gui = wnd->GetGui();
+    while (!finished) {
+        if (!WindowIsRunning()) {
+            worker.join();
+            exit(0);
+        }
+        wnd->HandleEvents();
+        if (!wnd->IsFrameReady()) {
+            continue;
+        }
+        gui->StartDraw();
+        sohFast3dWindow->StartFrame();
+        sohFast3dWindow->RunGuiOnly();
+        if (!ImGui::IsPopupOpen("Preparing Shaders")) {
+            ImGui::OpenPopup("Preparing Shaders");
+        }
+        ImGui::PushStyleVar(ImGuiStyleVar_FrameRounding, 3.0f);
+        ImGui::PushStyleVar(ImGuiStyleVar_FramePadding, ImVec2(10.0f, 8.0f));
+        auto color = UIWidgets::ColorValues.at(THEME_COLOR);
+        ImGui::PushStyleColor(ImGuiCol_TitleBgActive, color);
+        ImGui::PushStyleColor(ImGuiCol_FrameBg, ImVec4(color.x, color.y, color.z, 0.6f));
+        ImGui::PushStyleColor(ImGuiCol_PlotHistogram, ImVec4(color.x, color.y, color.z, 1.0f));
+        ImGui::PushStyleColor(ImGuiCol_Border, ImVec4(0.0f, 0.0f, 0.0f, 0.3f));
+        if (ImGui::BeginPopupModal("Preparing Shaders", NULL,
+                                   ImGuiWindowFlags_AlwaysAutoResize | ImGuiWindowFlags_NoResize |
+                                       ImGuiWindowFlags_NoMove | ImGuiWindowFlags_NoScrollbar |
+                                       ImGuiWindowFlags_NoSavedSettings)) {
+            const float progress = (float)done / (float)keys.size();
+            ImGui::Text("Compiling shaders for this console (first launch only)...");
+            std::string overlay = spdlog::fmt_lib::format("{} / {}", (size_t)done, keys.size());
+            ImGui::ProgressBar(progress, ImVec2(600.0f, 50.0f), overlay.c_str());
+            ImGui::EndPopup();
+        }
+        ImGui::PopStyleColor(4);
+        ImGui::PopStyleVar(2);
+        gui->EndDraw();
+        sohFast3dWindow->EndFrame();
+    }
+    worker.join();
+    std::ofstream(stampPath) << stamp << "\n";
+}
